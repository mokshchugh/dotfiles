#!/bin/bash

set -e

APP="$1"

if [ -z "$APP" ]; then
    echo "Usage: dotify <app>"
    exit 1
fi

SOURCE="$HOME/.config/$APP"
DEST="$HOME/dotfiles/configs/$APP"

# Check source exists
if [ ! -e "$SOURCE" ]; then
    echo "Error: $SOURCE does not exist"
    exit 1
fi

# Refuse if already symlinked
if [ -L "$SOURCE" ]; then
    echo "Error: $APP is already symlinked"
    exit 1
fi

# Refuse if destination exists
if [ -e "$DEST" ]; then
    echo "Error: $DEST already exists"
    exit 1
fi

echo "Moving:"
echo "  $SOURCE"
echo "→ $DEST"
echo

mv "$SOURCE" "$DEST"

if ! ln -s "$DEST" "$SOURCE"; then
    echo "Failed creating symlink. Rolling back..."
    mv "$DEST" "$SOURCE"
    exit 1
fi

echo
echo "✓ $APP added to dotfiles"

read -p "Git add config? [y/N] " answer

if [[ "$answer" =~ ^[Yy]$ ]]; then
    cd "$HOME/dotfiles"

    git add .

    echo
    echo "✓ Added to git staging area"
fi
