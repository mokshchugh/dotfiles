#!/bin/bash

set -e

APP="$1"

if [ -z "$APP" ]; then
    echo "Usage: undotify <app>"
    exit 1
fi

LINK="$HOME/.config/$APP"
SOURCE="$HOME/dotfiles/configs/$APP"
DEST="$HOME/.config/$APP"

target=$(readlink "$LINK")

if [ "$target" != "$SOURCE" ]; then
    echo "Error: symlink does not point to dotfiles"
    exit 1
fi

if [ ! -e "$SOURCE" ]; then
    echo "Error: $SOURCE does not exist"
    exit 1
fi

rm "$LINK"

mv "$SOURCE" "$DEST"

echo
echo "✓ $APP removed from dotfiles"

read -p "Remove from git tracking? [y/N] " answer

if [[ "$answer" =~ ^[Yy]$ ]]; then
    cd "$HOME/dotfiles"

    git rm -r --cached "configs/$APP" 2>/dev/null || true

    echo
    echo "✓ Removed from git staging"
fi
